	do stats.adjust_personality("energy", 2)
	do stats.record_answer("wyr_pet", "pocket dragon")
	{{pet_name}}: [[a dragon?? what if it takes my spot... i'm kidding. mostly.|a tiny dragon would be so cool!]]
- a cloud that follows me.
	do stats.adjust_personality("calmness", 2)
	do stats.record_answer("wyr_pet", "follow-me cloud")
	{{pet_name}}: [[a little personal cloud. so soft and peaceful.|it could rain on command. that's useful!]]
- a tiny robot buddy!
	do stats.adjust_personality("curiosity", 2)
	do stats.record_answer("wyr_pet", "robot buddy")
	{{pet_name}}: [[beep boop! very cute.|a robot friend would be amazing!]]
=> END

~ chat_color
{{pet_name}}: what color feels the most like you right now?
- warm colors, like orange and gold.
	do stats.adjust_personality("cheerfulness", 2)
	do stats.record_answer("color_pref", "warm colors")
	{{pet_name}}: [[like a sunset. i love that.|warm and glowy. very you.]]
- cool colors, like blue and teal.
	do stats.adjust_personality("calmness", 2)
	do stats.record_answer("color_pref", "cool colors")
	{{pet_name}}: [[calm and peaceful. like the ocean.|cool tones are so soothing.]]
- dark and moody, like purple and black.
	do stats.adjust_personality("curiosity", 2)
	do stats.record_answer("color_pref", "dark and moody")
	{{pet_name}}: [[mysterious. i like it.|dark and moody has such style.]]
=> END

~ chat_small_win
{{pet_name}}: did anything nice happen today? even something tiny counts!
- yeah, actually!
	do stats.adjust_personality("cheerfulness", 2)
	{{pet_name}}: [[yay! tell the universe, i'm listening!|i knew it! good things find you.]]
- not really...
	do stats.adjust_personality("affection", 3)
	{{pet_name}}: [[well... you're here with me now. that's something, right? <3|then let's make one right now. you deserve it.]]
- does a snack count?
	do stats.adjust_personality("energy", 2)
	{{pet_name}}: [[a snack always counts!|snacks are 100% valid small wins.]]
=> END

# ==============================================================================
# 3. MEMORY CALL-BACKS & PERSONALITY CHECKS
# ==============================================================================
~ chat_remember
if stats.player_answers.has("weather_pref") and randf() < 0.5:
	{{pet_name}}: whenever the weather shifts, i remember you're a fan of {{stats.player_answers["weather_pref"]}} days!
elif stats.player_answers.has("favorite_snack") and randf() < 0.5:
	{{pet_name}}: thinking about your favorite {{stats.player_answers["favorite_snack"]}}... makes me want to visit the shop for a treat!
elif stats.player_answers.has("fav_spot"):
	{{pet_name}}: remember when we talked about going to {{stats.player_answers["fav_spot"]}}? still holds up as the dream destination!
else:
	{{pet_name}}: [[i'm always collecting little notes about what you like.|it's fun learning more about you as we hang out!]]
=> END

~ remember_weather
if stats.player_answers["weather_pref"] == "rainy":
	% {{pet_name}}: rainy days are your favorite, right? i'm saving up cozy thoughts for the next one.
	% {{pet_name}}: i bet you love the sound of rain on the window. i would too, if i had a window.
elif stats.player_answers["weather_pref"] == "sunny":
	% {{pet_name}}: sunshine person! i hope you get a sunny day soon.
	% {{pet_name}}: crisp, sunny, breezy... i remember! you have great taste in weather.
else:
	% {{pet_name}}: snowy nights are your thing, huh? hot cocoa season is basically a holiday.
	% {{pet_name}}: i keep imagining the two of us watching snow fall. so quiet and cozy.
=> END

~ remember_snack
if stats.player_answers["favorite_snack"] == "sweet pastries":
	% {{pet_name}}: thinking about pastries again... you and your sweet tooth! i'm not judging.
	% {{pet_name}}: if i could bake, you'd get a fresh pastry every single day.
elif stats.player_answers["favorite_snack"] == "savory snacks":
	% {{pet_name}}: savory snacks forever! crunch crunch.
	% {{pet_name}}: i'd love to know your favorite savory snack flavor. i'm curious!
else:
	% {{pet_name}}: fresh fruit fan! the healthy one of us. i'm impressed.
	% {{pet_name}}: you like fresh fruit, right? i hope you're eating some today!
=> END

~ remember_spot
if stats.player_answers["fav_spot"] == "the forest":
	% {{pet_name}}: still thinking about that quiet forest. we should go someday, in spirit.
	% {{pet_name}}: the forest is calling... i'll bring the snacks.
elif stats.player_answers["fav_spot"] == "the city":
	% {{pet_name}}: all those lights and sounds in the city... i still want to go!
	% {{pet_name}}: the city adventure is still on my list!
else:
	% {{pet_name}}: nothing beats staying right here with you. still my favorite spot.
	% {{pet_name}}: cozy at home forever! best destination.
=> END

~ remember_music
if stats.player_answers["music_pref"] == "lo-fi":
	% {{pet_name}}: lo-fi is your go-to, right? it's basically my theme song now.
	% {{pet_name}}: i hum along to lo-fi when you're not listening. shh.
elif stats.player_answers["music_pref"] == "high energy":
	% {{pet_name}}: upbeat tunes! bounce bounce! i remember.
	% {{pet_name}}: if you ever play something loud, i might dance a little.
else:
	% {{pet_name}}: quiet is your thing. i'll keep it down. very still. very silent.
	% {{pet_name}}: pure peace and quiet... i respect it.
=> END

~ remember_sleep
if stats.player_answers["sleep_type"] == "early bird":
	% {{pet_name}}: early bird! please save some morning energy for me.
	% {{pet_name}}: you're up with the sun. i'm impressed!
elif stats.player_answers["sleep_type"] == "night owl":
	% {{pet_name}}: night owl... i'll keep you company when it's late.
	% {{pet_name}}: late night ideas are the best ideas. but sleep too, okay?
else:
	% {{pet_name}}: chaotic sleep schedule club! just try to rest when you can, okay?
	% {{pet_name}}: i worry about you and your sleep. just a little. be gentle with yourself!
=> END

~ remember_animal
if stats.player_answers["pet_animal"] == "a fluffy fox":
	% {{pet_name}}: i still think about being a fluffy fox. so much pouncing!
	% {{pet_name}}: fox mode: sly, fluffy, and extremely good at hiding snacks.
elif stats.player_answers["pet_animal"] == "a sleepy cat":
