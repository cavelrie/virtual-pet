else:
	% {{pet_name}}: a treehouse in the woods! so much cozy adventure.
	% {{pet_name}}: i'd love to visit your treehouse. i'll bring snacks.
=> END

~ remember_color
if stats.player_answers["color_pref"] == "warm colors":
	% {{pet_name}}: warm colors, like orange and gold... like a sunset!
	% {{pet_name}}: warm colors suit you. very cozy vibes.
elif stats.player_answers["color_pref"] == "cool colors":
	% {{pet_name}}: cool colors, like blue and teal... so calm.
