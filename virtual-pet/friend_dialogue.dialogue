	% {{pet_name}}: you make this little corner of the screen feel like home.
else:
	% {{pet_name}}: hey, thanks for hanging out with me today! i had fun :D
	% {{pet_name}}: we're a good pair, you and me!
=> END

# ==============================================================================
# 4. TIC TAC TOE: invitation + live commentary
#    companion.gd shows these in a small auto-hiding bubble (not a full balloon),
#    so don't put choices or "do" mutations in the ttt_* commentary titles.
# ==============================================================================
~ invite_tictactoe
{{pet_name}}: [[psst... wanna play tic tac toe with me?|i'm a little bored... tic tac toe, you and me?|i've been practicing tic tac toe. wanna see?|tic tac toe challenge! are you brave enough?]]
- yes, let's play!
	do queue_game("tictactoe")
	do stats.adjust_personality("energy", 1)
	{{pet_name}}: [[yay!! i'll set up the board!|okay okay okay! i'm ready!|prepare to lose. kidding. maybe.]]
- maybe later
	{{pet_name}}: [[okay! the offer stands :3|no worries! i'll be here.]]
- not right now
	{{pet_name}}: [[that's okay! i'll ask again another time.|aww okay. go do your thing!]]
=> END

~ ttt_start
% {{pet_name}}: you're X, i'm O! ready? let's go!
% {{pet_name}}: i'll be O. no peeking at my strategy!
% {{pet_name}}: okay okay okay, game face on. :D
% {{pet_name}}: i call dibs on being very, very competitive.
=> END

~ ttt_next_you
% {{pet_name}}: round {{ttt.rounds_played + 1}}! you open this one.
% {{pet_name}}: your turn to start! make it count.
% {{pet_name}}: again! again! you go first this time.
=> END

~ ttt_next_pet
% {{pet_name}}: my turn to open! watch this.
% {{pet_name}}: i'm going first this round. brace yourself.
% {{pet_name}}: round {{ttt.rounds_played + 1}}... i've got a plan. probably.
=> END

~ ttt_player_move
% {{pet_name}}: hmm... interesting move.
% {{pet_name}}: ooh. i see what you're doing.
% {{pet_name}}: okay okay, a bold choice.
% {{pet_name}}: *squints at the board*
% {{pet_name}}: i'm thinking... very hard... *thinks*
=> END

~ ttt_player_block
% {{pet_name}}: hey! you blocked me!
% {{pet_name}}: nooo, i was so close!
% {{pet_name}}: sneaky... you saw that coming.
=> END

~ ttt_pet_move
% {{pet_name}}: this is all part of the plan.
% {{pet_name}}: hehe. watch and learn.
% {{pet_name}}: *taps O down very confidently*
% {{pet_name}}: i feel good about this one.
=> END

~ ttt_pet_block
% {{pet_name}}: not so fast! :p
% {{pet_name}}: blocked! nice try though.
% {{pet_name}}: i saw that coming a mile away.
% {{pet_name}}: nope! not today.
=> END

~ ttt_pet_slip
% {{pet_name}}: ...i meant to do that.
% {{pet_name}}: oops. my paw slipped.
% {{pet_name}}: wait. wait. i wasn't looking. can i redo that?
% {{pet_name}}: that was a strategic blunder. on purpose. definitely.
=> END

~ ttt_player_win
if ttt.player_score >= 3 and ttt.player_score > ttt.pet_score + 1:
	% {{pet_name}}: you're on a roll! i demand a rematch. and snacks.
	% {{pet_name}}: {{ttt.player_score}} wins already?! who taught you?
	% {{pet_name}}: okay, you're actually really good at this.
elif ttt.player_score == 1 and ttt.pet_score == 0:
	% {{pet_name}}: aww, you got me! first blood goes to you.
	% {{pet_name}}: well played! i let you win. ...mostly.
	% {{pet_name}}: nooo! okay, okay, good game!
else:
	% {{pet_name}}: you got me this time! gg!
	% {{pet_name}}: ahh, i'll get you next round!
	% {{pet_name}}: nice one! that was a good game.
=> END

~ ttt_pet_win
if ttt.pet_score > ttt.player_score + 1:
	% {{pet_name}}: {{ttt.pet_score}} to {{ttt.player_score}}! i'm a tic tac toe genius.
	% {{pet_name}}: i'm on fire! don't worry, i'll go easy... maybe.
	% {{pet_name}}: i'm not gloating. i'm just... very happy. :D
else:
	% {{pet_name}}: yay! i got three in a row!
	% {{pet_name}}: gotcha! good game though!
	% {{pet_name}}: ooh, that one was close!
	% {{pet_name}}: i win! hehe. rematch?
=> END

~ ttt_draw
% {{pet_name}}: a draw! we're evenly matched.
% {{pet_name}}: nobody wins... nobody loses. very peaceful.
% {{pet_name}}: a tie! i respect that.
% {{pet_name}}: the board is full! great minds think alike.
=> END

~ ttt_quit
if ttt.rounds_played == 0:
	% {{pet_name}}: leaving already? we didn't even finish a round!
	% {{pet_name}}: aww, no game? okay. next time!
elif ttt.player_score > ttt.pet_score:
	% {{pet_name}}: you won {{ttt.player_score}} to {{ttt.pet_score}}. i want a rematch later!
	% {{pet_name}}: good games! you beat me {{ttt.player_score}} to {{ttt.pet_score}}. i'll practice.
elif ttt.pet_score > ttt.player_score:
	% {{pet_name}}: i won {{ttt.pet_score}} to {{ttt.player_score}}! thanks for playing with me :D
	% {{pet_name}}: {{ttt.pet_score}} to {{ttt.player_score}} for me! i'm calling it a good day.
else:
	% {{pet_name}}: we ended tied at {{ttt.pet_score}}! a perfectly balanced match.
	% {{pet_name}}: thanks for playing! that was fun :3
=> END

# ==============================================================================
# 5. NEEDS: said first whenever the pet is hungry or bored (companion.gd, "need_*")
# ==============================================================================
~ need_food
if stats.inventory.has("apple") or stats.inventory.has("treat"):
	% {{pet_name}}: *tummy rumbles* ...there's food in the inventory, just saying...
	% {{pet_name}}: i'm sooo hungry. check the inventory? please? :3
	% {{pet_name}}: if someone happened to feed me, i would love them forever.
elif stats.coins >= 10:
	% {{pet_name}}: i'm starving... the shop has apples for 10 coins. i have {{stats.coins}} coins!
	% {{pet_name}}: my tummy is making noises. can we visit the shop?
	% {{pet_name}}: snack emergency! the shop is right there...
else:
	% {{pet_name}}: i'm hungry and my coin pouch is empty... maybe a game of tic tac toe to earn some?
	% {{pet_name}}: no food, no coins... winning a game would help. just saying.
=> END

~ need_play
{{pet_name}}: [[i'm so bored... will you play tic tac toe with me?|boredom levels critical. tic tac toe? please?|i've counted every pixel again. tic tac toe instead?]]
- sure, let's play!
	do queue_game("tictactoe")
	do stats.adjust_personality("energy", 1)
	{{pet_name}}: [[yay!! finally!|best. day. ever!|okay okay okay, setting up the board!]]
- maybe later
	{{pet_name}}: [[okay... i'll just count pixels again.|i'll be here. staring at a pixel. it's fine.]]
- not right now
	{{pet_name}}: [[aww, okay. a tap or two would help though...|that's okay! i'll keep myself busy.]]
=> END

