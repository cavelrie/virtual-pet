~ chat_personality_check
if stats.dominant_trait == "Cheerfulness":
	% {{pet_name}}: your bright energy rubs off on me! i feel like smiling all the time :D
	% {{pet_name}}: i think you're the reason my days feel sunny. thank you for that!
elif stats.dominant_trait == "Energy":
